  },
  "components": {
    "schemas": {
      "BatchEssayItem": {
        "required": [
          "themeId",
          "essayTypeId",
          "assetId",
          "parentEssayId"
        ],
        "type": "object",
        "properties": {
          "themeId": {
            "type": "string",
            "format": "uuid"
          },
          "essayTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "parentEssayId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "BatchEssayRequest": {
        "required": [
          "essays",
          "aiNoticeAccepted"
        ],
        "type": "object",
        "properties": {
          "essays": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/BatchEssayItem"
            }
          },
          "aiNoticeAccepted": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "BatchEssayResponseDto": {
        "required": [
          "essayIds"
        ],
        "type": "object",
        "properties": {
          "essayIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreditBalanceDto": {
        "required": [
          "total",
          "buckets"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditBucketDto"
            }
          }
        }
      },
      "CreditBucketDto": {
        "required": [
          "source",
          "remaining",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/CreditSource"
          },
          "remaining": {
            "type": "integer",
            "format": "int32"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "CreditSource": {
        "enum": [
          "trial",
          "plan_week",
          "single",
          "refund"
        ]
      },
      "EmailPreferencesDto": {
        "required": [
          "correctionReady",
          "illegibleReminder",
          "newThemes"
        ],
        "type": "object",
        "properties": {
          "correctionReady": {
            "type": "boolean"
          },
          "illegibleReminder": {
            "type": "boolean"
          },
          "newThemes": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "code",
          "message",
          "retryable",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "traceId": {
            "type": "string"
          }
        },
        "description": "Formato único de erro da API (especificação, seção 12)."
      },
      "EssayDetailDto": {
        "required": [
          "id",
          "title",
          "themeId",
          "essayTypeId",
          "status",
          "version",
          "hasVersions",
          "createdAt",
          "reviewDeadlineAt",
          "illegibleCount",
          "score",
          "maxScore",
          "failureCode",
          "sheetLines",
          "lines",
          "illegibleWords"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "themeId": {
            "type": "string",
            "format": "uuid"
          },
          "essayTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/EssayStatus"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "hasVersions": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewDeadlineAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "illegibleCount": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "maxScore": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "failureCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "sheetLines": {
            "type": "integer",
            "format": "int32"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptionLineDto"
            }
          },
          "illegibleWords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IllegibleWordDto"
            }
          }
        }
      },
      "EssayListDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EssaySummaryDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EssayStatus": {
        "enum": [
          "uploaded",
          "awaiting_review",
          "queued",
          "processing",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "EssaySummaryDto": {
        "required": [
          "id",
          "title",
          "themeId",
          "essayTypeId",
          "status",
          "version",
          "hasVersions",
          "createdAt",
          "reviewDeadlineAt",
          "illegibleCount",
          "score",
          "maxScore",
          "failureCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "themeId": {
            "type": "string",
            "format": "uuid"
          },
          "essayTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/EssayStatus"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "hasVersions": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewDeadlineAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "illegibleCount": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "maxScore": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "failureCode": {
            "type": [
              "null",
              "string"
