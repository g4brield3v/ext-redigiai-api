# Porta em que o docker compose publica o PostgreSQL local (padrão 5432). Se mudar aqui, use a mesma porta
# em ConnectionStrings__Default, logo abaixo.
DB_PORT=

# Back-end (api e worker)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=redigiai;Username=redigiai;Password=redigiai
Clerk__Issuer=
Clerk__JwksUrl=
Clerk__WebhookSecret=
# Opcional: só se o token de sessão do Clerk for configurado com "aud".
Clerk__Audience=
# Chave secreta da instância do Clerk (Backend API).
Clerk__SecretKey=
# Administradores: não há configuração. É a flag users.is_admin, ligada direto no banco (docs/decisoes.md, 20/10/2026).
Legal__TermsVersion=1
# true atrás do proxy do Railway, para ler o IP do aluno.
Proxy__TrustForwardedHeaders=false
Anthropic__ApiKey=
Anthropic__TranscriptionModel=claude-sonnet-5-5
Anthropic__GradingModel=claude-opus-5-5
# Cópia da coletânea: quantas palavras iguais em sequência contam como trecho copiado, e a partir de que parte
# da redação a cópia exige nota zero (padrões: 8 e 0.30).
CollectionCopy__MinWords=8
CollectionCopy__ZeroShare=0.30
# Limite das rotas de administração, por usuário (padrão: 120 por minuto).
RateLimit__AdminPerUserPerMinute=120
# Custo de IA por redação, em US$: a referência só gera alerta; acima do limite rígido, a redação falha e a
# correção volta para o saldo (padrões: 0.26 e 0.57).
Ai__ReferenceCapUsd=0.26
Ai__HardCapUsd=0.57
# Teto de segurança do tamanho da resposta da IA, em tokens (padrões: 55000 na correção e 8000 na transcrição).
# Resposta cortada ganha uma nova chamada com o dobro, até Ai__MaxOutputTokens (padrão: 128000).
Ai__Grading__MaxTokens=55000
Ai__Transcription__MaxTokens=8000
MercadoPago__AccessToken=
MercadoPago__WebhookSecret=
# Só em desenvolvimento: o e-mail do comprador de teste (test_user_<User ID>@testuser.com), que assina o plano no sandbox.
MercadoPago__TestPayerEmail=
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
# O envio de e-mails é ligado no banco (feature_flags.email_sending, desligado por padrão). Ligado e sem chave:
# em Development os e-mails viram arquivos HTML em SendGrid__OutboxPath (padrão .outbox); fora dele, não saem.
SendGrid__ApiKey=
SendGrid__From=correcoes@redigiai.com.br
Company__LegalName=
Company__Cnpj=
Company__Address=
Company__SupportEmail=
Cors__AllowedOrigins=http://localhost:5173
# Endereço do site, usado nos botões dos e-mails.
App__BaseUrl=http://localhost:5173
Sentry__Dsn=

# Front-end (prefixo VITE_ = público, nunca coloque segredos aqui)
VITE_API_URL=http://localhost:5080
VITE_CLERK_PUBLISHABLE_KEY=
VITE_MERCADOPAGO_PUBLIC_KEY=
VITE_SENTRY_DSN=
