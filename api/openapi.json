{
  "openapi": "3.1.1",
  "info": {
    "title": "RedigiAI API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/me": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Primeiro acesso: cria o usuário a partir do token, grava a data de nascimento (recusa menores de 16)\r\ne concede o crédito grátis uma única vez. Repetido, devolve o perfil que já existe.",
        "operationId": "registerMe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Perfil, saldo de correções por origem e preferências de e-mail.",
        "operationId": "getMe",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "patch": {
        "tags": [
          "Account"
        ],
        "summary": "Altera o nome e as preferências de e-mail.",
        "operationId": "updateMe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/v1/exams": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Vestibulares e status (ativo ou em breve).",
        "operationId": "listExams",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/exams/{slug}/themes": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Temas ativos do vestibular, com os tipos aceitos e o número de textos da coletânea.",
        "operationId": "listThemes",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ThemeSummaryDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/themes/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Enunciado, coletânea e tipos de redação aceitos pelo tema.",
        "operationId": "getTheme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThemeDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rubrics/{versionId}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Critérios, pesos e descritores de uma versão da grade.",
        "operationId": "getRubric",
        "parameters": [
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RubricDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/clerk": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Recebe um evento do Clerk (cabeçalhos `svix-id`, `svix-timestamp` e `svix-signature`).",
        "operationId": "receiveClerkWebhook",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "O processo está de pé.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "O banco está acessível.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreditBalanceDto": {
        "required": [
          "total",
          "buckets"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditBucketDto"
            }
          }
        }
      },
      "CreditBucketDto": {
        "required": [
          "source",
          "remaining",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/CreditSource"
          },
          "remaining": {
            "type": "integer",
            "format": "int32"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "CreditSource": {
        "enum": [
          "trial",
          "plan_week",
          "single",
          "refund"
        ]
      },
      "EmailPreferencesDto": {
        "required": [
          "correctionReady",
          "illegibleReminder",
          "newThemes"
        ],
        "type": "object",
        "properties": {
          "correctionReady": {
            "type": "boolean"
          },
          "illegibleReminder": {
            "type": "boolean"
          },
          "newThemes": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "code",
          "message",
          "retryable",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "traceId": {
            "type": "string"
          }
        },
        "description": "Formato único de erro da API (especificação, seção 12)."
      },
      "EssayTypeDto": {
        "required": [
          "id",
          "slug",
          "name",
          "description",
          "rubricVersionId",
          "instruction"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rubricVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "instruction": {
            "type": "string"
          }
        }
      },
      "ExamDto": {
        "required": [
          "slug",
          "name",
          "status",
          "sheetLines",
          "currentRubricVersionId"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ExamStatus"
          },
          "sheetLines": {
            "type": "integer",
            "format": "int32"
          },
          "currentRubricVersionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "ExamStatus": {
        "enum": [
          "active",
          "coming_soon"
        ]
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ProfileDto": {
        "required": [
          "id",
          "email",
          "name",
          "termsAcceptanceRequired",
          "aiNoticeAccepted",
          "emailPreferences",
          "credits"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "termsAcceptanceRequired": {
            "type": "boolean"
          },
          "aiNoticeAccepted": {
            "type": "boolean"
          },
          "emailPreferences": {
            "$ref": "#/components/schemas/EmailPreferencesDto"
          },
          "credits": {
            "$ref": "#/components/schemas/CreditBalanceDto"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "birthDate",
          "termsAccepted"
        ],
        "type": "object",
        "properties": {
          "birthDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "termsAccepted": {
            "type": "boolean"
          }
        }
      },
      "RubricCriterionDto": {
        "required": [
          "position",
          "name",
          "weight",
          "maxPoints",
          "levels"
        ],
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "format": "int32"
          },
          "maxPoints": {
            "type": "integer",
            "format": "int32"
          },
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RubricLevelDto"
            }
          }
        }
      },
      "RubricDto": {
        "required": [
          "id",
          "examSlug",
          "examName",
          "version",
          "maxScore",
          "criteria",
          "zeroRules"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "examSlug": {
            "type": "string"
          },
          "examName": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "maxScore": {
            "type": "integer",
            "format": "int32"
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RubricCriterionDto"
            }
          },
          "zeroRules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ZeroRuleDto"
            }
          }
        }
      },
      "RubricLevelDto": {
        "required": [
          "level",
          "descriptor"
        ],
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "descriptor": {
            "type": "string"
          }
        }
      },
      "ThemeDetailDto": {
        "required": [
          "id",
          "title",
          "statement",
          "examSlug",
          "examName",
          "sheetLines",
          "texts",
          "essayTypes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "examSlug": {
            "type": "string"
          },
          "examName": {
            "type": "string"
          },
          "sheetLines": {
            "type": "integer",
            "format": "int32"
          },
          "texts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThemeTextDto"
            }
          },
          "essayTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EssayTypeDto"
            }
          }
        }
      },
      "ThemeSummaryDto": {
        "required": [
          "id",
          "title",
          "examSlug",
          "examName",
          "essayTypes",
          "textCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "examSlug": {
            "type": "string"
          },
          "examName": {
            "type": "string"
          },
          "essayTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EssayTypeDto"
            }
          },
          "textCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ThemeTextDto": {
        "required": [
          "position",
          "kind",
          "title",
          "source",
          "body"
        ],
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/ThemeTextKind"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ThemeTextKind": {
        "enum": [
          "text",
          "image"
        ]
      },
      "UpdateEmailPreferences": {
        "required": [
          "correctionReady",
          "illegibleReminder",
          "newThemes"
        ],
        "type": "object",
        "properties": {
          "correctionReady": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "illegibleReminder": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "newThemes": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "UpdateProfileRequest": {
        "required": [
          "name",
          "emailPreferences"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "emailPreferences": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UpdateEmailPreferences"
              }
            ]
          }
        }
      },
      "ZeroRuleDto": {
        "required": [
          "code",
          "description"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Token de sessão do Clerk.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Webhooks"
    },
    {
      "name": "Health"
    }
  ]
}